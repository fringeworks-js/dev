{
  "name": "@fringeworks/dev",
  "version": "0.13.1",
  "private": true,
  "description": "A library some will find handy, built for developers.",
  "keywords": [
    "utils"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/dev.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./addJsExtensions": "./src/addJsExtensions/index.ts",
    "./checkExistence": "./src/checkExistence/index.ts",
    "./createESLintConfig": "./src/createESLintConfig/index.ts",
    "./createExports": "./src/createExports/index.ts",
    "./createExternal": "./src/createExternal/index.ts",
    "./createPrettierConfig": "./src/createPrettierConfig/index.ts",
    "./createSassClassNameFunction": "./src/createSassClassNameFunction/index.ts",
    "./createTsdownConfig": "./src/createTsdownConfig/index.ts",
    "./editJsonFile": "./src/editJsonFile/index.ts",
    "./generateIndexFiles": "./src/generateIndexFiles/index.ts",
    "./generatePublishPackageJson": "./src/generatePublishPackageJson/index.ts",
    "./installFromLocal": "./src/installFromLocal/index.ts",
    "./isIncludedPath": "./src/isIncludedPath/index.ts",
    "./isMatchingPath": "./src/isMatchingPath/index.ts",
    "./moveFilesToSubdirs": "./src/moveFilesToSubdirs/index.ts",
    "./removeFiles": "./src/removeFiles/index.ts",
    "./setVersion": "./src/setVersion/index.ts",
    "./writeExports": "./src/writeExports/index.ts",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch --config-loader tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "test": "vitest",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts",
    "writeexport": "tsx scripts/exports.ts"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fringeworks/rollup-plugin-dist-package": "^0.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "remeda": "^2.34.0",
    "sass": "^1.105.0",
    "type-fest": "^5.6.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
